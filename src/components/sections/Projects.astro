---
import Section from "@/components/Section.astro";
import { projects } from "@cv";
---

<Section title="Projects">
    <ul>
        {
            projects.map(({ url, description, highlights, name, isActive }) => {
                return (
                    <li>
                        <article>
                            <header>
                                <h3>
                                    <a
                                        href={url}
                                        title={`Checkout project: ${name}`}
                                        target="_blank"
                                    >
                                        {name}
                                    </a>
                                    {isActive && <span class="active-dot" title="Active">&#9679;</span>}
                                </h3>
                                <p>{description}</p>
                            </header>
                            <footer>
                                {highlights.map((highlight: any) => {
                                    return <span class="tag">{highlight}</span>;
                                })}
                            </footer>
                        </article>
                    </li>
                );
            })
        }
    </ul>
</Section>

<style>
    ul {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 16px;
    }

    article {
        border: 2px solid var(--border);
        background: var(--card-bg);
        box-shadow: var(--shadow-green);
        padding: 14px 16px;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: box-shadow 0.1s, transform 0.1s;
    }

    article:hover {
        box-shadow: 6px 6px 0 0 var(--border);
        transform: translate(-2px, -2px);
    }

    header {
        flex: 1;
    }

    h3 {
        font-family: 'Press Start 2P', monospace;
        font-size: 0.48rem;
        color: var(--title);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
        flex-wrap: wrap;
        line-height: 1.8;
    }

    h3 a {
        color: var(--link);
        text-decoration: none;
        transition: color 0.1s;
    }

    h3 a:hover {
        color: var(--accent);
    }

    .active-dot {
        color: var(--border);
        font-size: 0.65rem;
        animation: blink-dot 1.2s step-start infinite;
    }

    @keyframes blink-dot {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0; }
    }

    p {
        font-size: 0.63rem;
        line-height: 1.6;
        color: var(--text-muted);
    }

    footer {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .tag {
        font-family: 'Share Tech Mono', monospace;
        font-size: 0.58rem;
        background: transparent;
        color: var(--title);
        border: 1px solid var(--title);
        padding: 2px 6px;
        box-shadow: 1px 1px 0 0 #5a3d00;
        letter-spacing: 0.03em;
    }
</style>
